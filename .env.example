# ============================================
# SillTech Solutions - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============ SERVER ============
# Server port (default: 3000)
PORT=3000

# Node environment: development, staging, or production
NODE_ENV=development

# Application URL (used for email links, redirects)
APP_URL=http://localhost:3000

# ============ DATABASE ============
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/silltechdb
DATABASE_URL=postgresql://postgres:password@localhost:5432/silltechdb

# Database connection pool settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ============ SECURITY ============
# JWT Secret (generate with: openssl rand -base64 32)
# Minimum 32 characters. Change immediately in production!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-this

# Session Secret (generate with: openssl rand -base64 32)
# Minimum 32 characters. Change immediately in production!
SESSION_SECRET=your-super-secret-session-key-minimum-32-chars-change-this

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000

# ============ CORS ============
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://silltechsolutions.co.ke,https://www.silltechsolutions.co.ke
ALLOWED_ORIGINS=http://localhost:3000

# ============ RATE LIMITING ============
# General API rate limit (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth rate limit (requests per 15 minutes)
AUTH_RATE_LIMIT_MAX=20

# Checkout rate limit (requests per 60 seconds)
CHECKOUT_RATE_LIMIT_WINDOW=60000
CHECKOUT_RATE_LIMIT_MAX=5

# ============ FILE UPLOAD ============
# Directory for uploaded files (relative or absolute path)
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 5MB = 5242880)
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ============ PAYMENT (M-PESA) ============
# Enable M-Pesa integration
MPESA_ENABLED=true

# M-Pesa Environment: sandbox or production
MPESA_ENVIRONMENT=sandbox

# M-Pesa API Credentials (get from https://developer.safaricom.co.ke/)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret

# M-Pesa Business Details
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=your-till-number

# M-Pesa Pass Key (for STK Push)
MPESA_PASSKEY=your-mpesa-passkey

# M-Pesa Callback URL (must be publicly accessible)
MPESA_CALLBACK_URL=https://your-domain.com/payments/mpesa/callback

# ============ LOGGING ============
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file directory
LOG_DIR=./logs

# ============ EMAIL (Optional) ============
# SMTP Configuration for order confirmations, newsletters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@silltechsolutions.co.ke

# ============ SITE CONFIGURATION ============
SITE_NAME=SillTech Solutions
SITE_TAGLINE=Kenya's Electronics Components Store
CURRENCY=KES

# ============ ADMIN SETTINGS ============
# Default admin email (for seeding)
ADMIN_EMAIL=admin@silltechsolutions.co.ke
# Default admin password (CHANGE IMMEDIATELY)
ADMIN_PASSWORD=Admin@1234
